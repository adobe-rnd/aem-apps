{
  "src": [
    "**/*.js",
    "**/*.html",
    "!node_modules/**",
    "!tools/deps/**"
  ],
  "license": "license.txt",
  "ignore": [
    "node_modules/**",
    "tools/deps/**",
    "**/*.css",
    "**/*.md",
    ".husky/**",
    ".github/**",
    ".editorconfig",
    ".eslintignore",
    ".eslintrc.js",
    ".gitignore",
    ".hlxignore",
    ".idea/**",
    ".DS_Store",
    "**/.DS_Store",
    "**/*.yaml",
    "**/*.yml",
    "**/*.json",
    "**/*.svg",
    "**/*.woff",
    "**/*.woff2",
    "**/*.ttf",
    "**/*.eot"
  ],
  "blocking": true,
  "logInfo": false,
  "logError": true,
  "licenseFormats": {
    "js": {
      "prepend": "/*",
      "append": " */",
      "eachLine": {
        "prepend": " * "
      }
    },
    "html": {
      "prepend": "<!--",
      "append": "-->",
      "eachLine": {
        "prepend": " "
      }
    }
  },
  "trailingWhitespace": "TRIM"
}
